                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "tickets"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Agents",
