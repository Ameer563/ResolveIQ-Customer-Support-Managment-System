                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": \"HIGH\"\n}"
            }
          }
        },
        {
          "name": "Assign agent",
          "request": {
            "method": "PUT",
            "header": [
